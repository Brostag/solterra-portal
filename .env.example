# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma (Transaction pooler port 6543 for DATABASE_URL)
DATABASE_URL=
# Prisma (Session pooler / Direct connection port 5432 for DIRECT_URL)
DIRECT_URL=

# App
NEXT_PUBLIC_SITE_URL=

# Feedback in-app / soporte
# ACCESO a la bandeja /soporte: correos separados por coma. Se comparan contra el
# correo con que la persona inicia sesión en el portal. Sin esto, nadie la ve.
SOPORTE_EMAILS=
# DESTINO del aviso por correo. Es distinto del anterior a propósito: quien
# administra los reportes no tiene por qué recibirlos en el mismo buzón.
SOPORTE_NOTIFICAR_A=
# Aviso por correo al llegar un reporte. Opcional: sin estas variables el
# feedback se guarda igual y solo se deja de enviar el aviso.
RESEND_API_KEY=
# Remitente. onboarding@resend.dev solo entrega al correo dueño de la cuenta de
# Resend; para escribirle a cualquier otra dirección hay que verificar un
# dominio en resend.com/domains y usar un remitente de ese dominio.
SOPORTE_EMAIL_FROM=
