generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMINISTRADOR
  SUPERVISOR
  USUARIO
}

enum EstadoFactura {
  CREADA
  ENVIADA
  PAGADA
  ANULADA
}

enum EstadoOC {
  BORRADOR
  EMITIDA
  ENVIADA
  APROBADA
  RECHAZADA
  ANULADA
}

enum Moneda {
  CLP
  USD
  UF
}

model CompanySettings {
  id               String   @id @default(uuid())
  razon_social     String
  rut              String
  giro             String?
  direccion        String?
  telefono         String?
  email            String?
  logo_url         String?
  moneda_principal Moneda   @default(CLP)
  iva_porcentaje   Decimal  @default(19)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("company_settings")
}

model Profile {
  id              String          @id @default(uuid())
  auth_user_id    String          @unique
  nombre          String
  email           String          @unique
  rol             Rol             @default(USUARIO)
  activo          Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  invoices        Invoice[]
  audit_logs      AuditLog[]
  purchaseOrders  PurchaseOrder[]
  documents       Document[]

  @@map("profiles")
}

model Client {
  id            String     @id @default(uuid())
  nombre        String
  rut           String?
  email         String?
  telefono      String?
  direccion     String?
  observaciones String?
  activo        Boolean    @default(true)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  invoices      Invoice[]
  documents     Document[]

  @@map("clients")
}

model Product {
  id                  String              @id @default(uuid())
  codigo_interno      String?
  nombre              String
  descripcion         String?
  precio_unitario     Decimal
  activo              Boolean             @default(true)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  invoice_items       InvoiceItem[]
  purchaseOrderItems  PurchaseOrderItem[]

  @@map("products")
}

model Invoice {
  id                String        @id @default(uuid())
  numero_factura    String        @unique
  client_id         String
  user_id           String
  moneda            Moneda        @default(CLP)
  tipo_cambio       Decimal       @default(1)
  fecha_tipo_cambio DateTime      @default(now())
  subtotal          Decimal
  iva               Decimal
  total             Decimal
  estado            EstadoFactura @default(CREADA)
  motivo_anulacion  String?
  fecha_emision     DateTime      @default(now())
  pdf_url           String?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  client            Client        @relation(fields: [client_id], references: [id])
  user              Profile       @relation(fields: [user_id], references: [id])
  items             InvoiceItem[]
  documents         Document[]

  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoice_id      String
  product_id      String?
  descripcion     String
  cantidad        Decimal
  precio_unitario Decimal
  subtotal        Decimal
  created_at      DateTime @default(now())
  invoice         Invoice  @relation(fields: [invoice_id], references: [id])
  product         Product? @relation(fields: [product_id], references: [id])

  @@map("invoice_items")
}

model Document {
  id                String         @id @default(uuid())
  nombre_archivo    String
  nombre_original   String
  tipo_documento    String
  storage_path      String
  tamaño            Int
  mime_type         String
  invoice_id        String?
  purchase_order_id String?
  client_id         String?
  supplier_id       String?
  uploaded_by       String
  created_at        DateTime       @default(now())
  invoice           Invoice?       @relation(fields: [invoice_id], references: [id])
  purchase_order    PurchaseOrder? @relation(fields: [purchase_order_id], references: [id])
  client            Client?        @relation(fields: [client_id], references: [id])
  supplier          Supplier?      @relation(fields: [supplier_id], references: [id])
  uploader          Profile        @relation(fields: [uploaded_by], references: [id])

  @@map("documents")
}

model Supplier {
  id             String          @id @default(uuid())
  nombre         String
  rut            String?
  giro           String?
  direccion      String?
  ciudad         String?
  telefono       String?
  email          String?
  contacto       String?
  observaciones  String?
  activo         Boolean         @default(true)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  documents      Document[]

  @@map("suppliers")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  numero           String              @unique
  proveedor_id     String
  creado_por       String
  fecha_emision    DateTime            @default(now())
  fecha_envio      DateTime?
  moneda           Moneda              @default(CLP)
  tipo_cambio      Decimal?            @db.Decimal(10, 4)
  condiciones_pago String?
  observaciones    String?
  subtotal         Decimal             @default(0) @db.Decimal(12, 2)
  descuento_pct    Decimal             @default(0) @db.Decimal(5, 2)
  descuento_monto  Decimal             @default(0) @db.Decimal(12, 2)
  neto             Decimal             @default(0) @db.Decimal(12, 2)
  iva_monto        Decimal             @default(0) @db.Decimal(12, 2)
  total            Decimal             @default(0) @db.Decimal(12, 2)
  estado           EstadoOC            @default(BORRADOR)
  motivo_anulacion String?
  pdf_url          String?
  activo           Boolean             @default(true)
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt
  proveedor        Supplier            @relation(fields: [proveedor_id], references: [id])
  creadoPor        Profile             @relation(fields: [creado_por], references: [id])
  items            PurchaseOrderItem[]
  documents        Document[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String         @id @default(uuid())
  orden_compra_id String
  producto_id     String?
  descripcion     String
  cantidad        Decimal        @db.Decimal(10, 2)
  valor_unitario  Decimal        @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  orden           Int
  ordenCompra     PurchaseOrder  @relation(fields: [orden_compra_id], references: [id], onDelete: Cascade)
  producto        Product?       @relation(fields: [producto_id], references: [id])

  @@map("purchase_order_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String
  accion     String
  modulo     String
  detalle    String?
  created_at DateTime @default(now())
  user       Profile  @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}
