generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Area {
  OPERACIONES
  MANTENCION
}

enum Rol {
  ADMINISTRADOR
  SUPERVISOR
  USUARIO
}

enum EstadoFactura {
  CREADA
  ENVIADA
  PAGADA
  ANULADA
}

enum EstadoOC {
  BORRADOR
  EMITIDA
  ENVIADA
  APROBADA
  RECHAZADA
  ANULADA
}

enum Moneda {
  CLP
  USD
  UF
}

enum EstadoContrato {
  BORRADOR
  VIGENTE
  FINALIZADO
  ANULADO
}

enum TipoFotoEquipo {
  FRONTAL
  LATERAL_DERECHO
  LATERAL_IZQUIERDO
  TRASERA
  CABINA
  HOROMETRO
  RODADO
  DANIOS
  OTRO
}

model CompanySettings {
  id               String   @id @default(uuid())
  razon_social     String
  rut              String
  giro             String?
  direccion        String?
  telefono         String?
  email            String?
  logo_url         String?
  moneda_principal Moneda   @default(CLP)
  iva_porcentaje   Decimal  @default(19)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("company_settings")
}

model Profile {
  id                        String                   @id @default(uuid())
  auth_user_id              String                   @unique
  nombre                    String
  email                     String                   @unique
  rol                       Rol                      @default(USUARIO)
  activo                    Boolean                  @default(true)
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt
  invoices                  Invoice[]
  audit_logs                AuditLog[]
  purchaseOrders            PurchaseOrder[]
  documents                 Document[]
  contracts                 Contract[]
  contract_equipment_photos ContractEquipmentPhoto[]
  area                      Area?
  mant_partes_diarios       MantParteDiario[]        @relation("ParteDiarioOperador")
  mant_mantenciones         MantMantencion[]         @relation("MantencionResponsable")
  mant_checklists           MantChecklist[]          @relation("ChecklistOperador")
  mant_checklists_anulados  MantChecklist[]          @relation("ChecklistAnuladoPor")
  mant_checklists_mant      MantChecklistMantencion[]   @relation("ChecklistMantResponsable")
  mant_checklists_mant_anul MantChecklistMantencion[]   @relation("ChecklistMantAnuladoPor")
  mant_certs_mant_encargado MantCertificadoMantencion[] @relation("CertMantEncargado")
  mant_certs_mant_gerente   MantCertificadoMantencion[] @relation("CertMantGerente")
  mant_certs_mant_anulado   MantCertificadoMantencion[] @relation("CertMantAnuladoPor")

  @@map("profiles")
}

model Client {
  id            String     @id @default(uuid())
  nombre        String
  rut           String?
  email         String?
  telefono      String?
  direccion     String?
  observaciones String?
  activo        Boolean    @default(true)
  company_id    String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  company       Company?   @relation(fields: [company_id], references: [id])
  invoices      Invoice[]
  documents     Document[]
  contracts     Contract[]

  @@index([company_id])
  @@map("clients")
}

model Product {
  id                 String              @id @default(uuid())
  codigo_interno     String?
  nombre             String
  descripcion        String?
  precio_unitario    Decimal
  activo             Boolean             @default(true)
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  invoice_items      InvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("products")
}

model Invoice {
  id                String        @id @default(uuid())
  numero_factura    String        @unique
  client_id         String
  user_id           String
  moneda            Moneda        @default(CLP)
  tipo_cambio       Decimal       @default(1)
  fecha_tipo_cambio DateTime      @default(now())
  subtotal          Decimal
  iva               Decimal
  total             Decimal
  estado            EstadoFactura @default(CREADA)
  motivo_anulacion  String?
  fecha_emision     DateTime      @default(now())
  pdf_url           String?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  client            Client        @relation(fields: [client_id], references: [id])
  user              Profile       @relation(fields: [user_id], references: [id])
  items             InvoiceItem[]
  documents         Document[]

  @@index([client_id])
  @@index([created_at])
  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoice_id      String
  product_id      String?
  descripcion     String
  cantidad        Decimal
  precio_unitario Decimal
  subtotal        Decimal
  created_at      DateTime @default(now())
  invoice         Invoice  @relation(fields: [invoice_id], references: [id])
  product         Product? @relation(fields: [product_id], references: [id])

  @@index([invoice_id])
  @@map("invoice_items")
}

model Document {
  id                String         @id @default(uuid())
  nombre_archivo    String
  nombre_original   String
  tipo_documento    String
  storage_path      String
  tamaño           Int
  mime_type         String
  invoice_id        String?
  purchase_order_id String?
  client_id         String?
  supplier_id       String?
  contract_id       String?
  uploaded_by       String
  created_at        DateTime       @default(now())
  invoice           Invoice?       @relation(fields: [invoice_id], references: [id])
  purchase_order    PurchaseOrder? @relation(fields: [purchase_order_id], references: [id])
  client            Client?        @relation(fields: [client_id], references: [id])
  supplier          Supplier?      @relation(fields: [supplier_id], references: [id])
  contract          Contract?      @relation(fields: [contract_id], references: [id])
  uploader          Profile        @relation(fields: [uploaded_by], references: [id])

  @@index([invoice_id])
  @@index([purchase_order_id])
  @@index([client_id])
  @@index([supplier_id])
  @@index([contract_id])
  @@index([created_at])
  @@map("documents")
}

model Supplier {
  id             String          @id @default(uuid())
  nombre         String
  rut            String?
  giro           String?
  direccion      String?
  ciudad         String?
  telefono       String?
  email          String?
  contacto       String?
  observaciones  String?
  activo         Boolean         @default(true)
  company_id     String?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  company        Company?        @relation(fields: [company_id], references: [id])
  purchaseOrders PurchaseOrder[]
  documents      Document[]

  @@index([company_id])
  @@map("suppliers")
}

model Company {
  id                     String     @id @default(uuid())
  nombre_razon_social    String
  rut                    String?
  giro                   String?
  email                  String?
  telefono               String?
  direccion              String?
  comuna                 String?
  ciudad                 String?
  region                 String?
  pais                   String?    @default("Chile")
  observaciones          String?
  activo                 Boolean    @default(true)
  es_cliente             Boolean    @default(false)
  es_proveedor           Boolean    @default(false)
  es_arrendataria        Boolean    @default(false)
  es_otro                Boolean    @default(false)
  representante_legal    String?
  rut_representante      String?
  cargo_representante    String?
  email_representante    String?
  telefono_representante String?
  contacto_nombre        String?
  contacto_cargo         String?
  contacto_email         String?
  contacto_telefono      String?
  condicion_pago         String?
  correo_notificaciones  String?
  banco                  String?
  tipo_cuenta            String?
  numero_cuenta          String?
  titular_cuenta         String?
  rut_titular_cuenta     String?
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt
  clients                Client[]
  suppliers              Supplier[]

  @@map("companies")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  numero           String              @unique
  proveedor_id     String
  creado_por       String
  fecha_emision    DateTime            @default(now())
  fecha_envio      DateTime?
  moneda           Moneda              @default(CLP)
  tipo_cambio      Decimal?            @db.Decimal(10, 4)
  condiciones_pago String?
  observaciones    String?
  subtotal         Decimal             @default(0) @db.Decimal(12, 2)
  descuento_pct    Decimal             @default(0) @db.Decimal(5, 2)
  descuento_monto  Decimal             @default(0) @db.Decimal(12, 2)
  neto             Decimal             @default(0) @db.Decimal(12, 2)
  iva_monto        Decimal             @default(0) @db.Decimal(12, 2)
  total            Decimal             @default(0) @db.Decimal(12, 2)
  estado           EstadoOC            @default(BORRADOR)
  motivo_anulacion String?
  pdf_url          String?
  activo           Boolean             @default(true)
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt
  proveedor        Supplier            @relation(fields: [proveedor_id], references: [id])
  creadoPor        Profile             @relation(fields: [creado_por], references: [id])
  items            PurchaseOrderItem[]
  documents        Document[]

  @@index([proveedor_id])
  @@index([created_at])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  orden_compra_id String
  producto_id     String?
  descripcion     String
  cantidad        Decimal       @db.Decimal(10, 2)
  valor_unitario  Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  orden           Int
  ordenCompra     PurchaseOrder @relation(fields: [orden_compra_id], references: [id], onDelete: Cascade)
  producto        Product?      @relation(fields: [producto_id], references: [id])

  @@index([orden_compra_id])
  @@map("purchase_order_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String
  accion     String
  modulo     String
  detalle    String?
  created_at DateTime @default(now())
  user       Profile  @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([created_at])
  @@map("audit_logs")
}

model Contract {
  id                         String              @id @default(uuid())
  numero_contrato            String              @unique
  fecha_emision              DateTime            @default(now())
  client_id                  String
  representante_cliente      String?
  rut_representante          String?
  cliente_snapshot_at        DateTime?
  cliente_nombre_snapshot    String?
  cliente_rut_snapshot       String?
  cliente_direccion_snapshot String?
  cliente_email_snapshot     String?
  cliente_telefono_snapshot  String?
  fecha_inicio               DateTime
  fecha_termino              DateTime?
  duracion_meses             Int?
  lugar_operacion            String?
  moneda                     Moneda              @default(CLP)
  forma_pago                 String?
  estado                     EstadoContrato      @default(BORRADOR)
  motivo_anulacion           String?
  observaciones              String?
  ciudad_celebracion         String?
  vigencia_contrato          String?
  numero_anexo               String?
  fecha_anexo                DateTime?
  numero_cotizacion          String?
  correo_notificaciones      String?
  user_id                    String
  pdf_url                    String?
  created_at                 DateTime            @default(now())
  updated_at                 DateTime            @updatedAt
  client                     Client              @relation(fields: [client_id], references: [id])
  user                       Profile             @relation(fields: [user_id], references: [id])
  equipos                    ContractEquipment[]
  documents                  Document[]

  @@index([client_id])
  @@index([estado])
  @@index([created_at])
  @@map("contracts")
}

model ContractEquipment {
  id                      String                   @id @default(uuid())
  contract_id             String
  orden                   Int
  descripcion             String
  marca                   String?
  modelo                  String?
  patente                 String?
  anio                    Int?
  chasis                  String?
  motor                   String?
  color                   String?
  valor_hora              Decimal                  @db.Decimal(12, 2)
  horas_minimas_diarias   Int?
  horas_minimas_mensuales Int?
  valor_mensual_estimado  Decimal?                 @db.Decimal(14, 2)
  tarifa_hora_extra       Decimal?                 @db.Decimal(12, 2)
  horometro_inicial       String?
  mantenimiento_horas     String?
  observaciones           String?
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  contract                Contract                 @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  photos                  ContractEquipmentPhoto[]

  @@index([contract_id])
  @@map("contract_equipments")
}

model ContractEquipmentPhoto {
  id                    String            @id @default(uuid())
  contract_equipment_id String
  tipo                  TipoFotoEquipo
  storage_path          String
  nombre_original       String
  mime_type             String
  tamano                Int
  observacion           String?
  uploaded_by           String
  created_at            DateTime          @default(now())
  contract_equipment    ContractEquipment @relation(fields: [contract_equipment_id], references: [id], onDelete: Cascade)
  uploader              Profile           @relation(fields: [uploaded_by], references: [id])

  @@index([contract_equipment_id])
  @@index([tipo])
  @@map("contract_equipment_photos")
}

enum EstadoCotizacion {
  BORRADOR
  EMITIDA
  ANULADA
}

model Quotation {
  id                         String           @id @default(cuid())
  numero                     String           @unique
  company_id                 String?
  cliente_nombre_snapshot    String?
  cliente_rut_snapshot       String?
  cliente_giro_snapshot      String?
  cliente_email_snapshot     String?
  cliente_telefono_snapshot  String?
  cliente_direccion_snapshot String?
  fecha_emision              DateTime         @default(now())
  moneda                     String           @default("CLP")
  iva_porcentaje             Decimal          @db.Decimal(5, 2)
  descuento_porcentaje       Decimal          @default(0) @db.Decimal(5, 2)
  gastos                     Json             @default("{}")
  subtotal                   Decimal          @db.Decimal(14, 2)
  descuento_monto            Decimal          @default(0) @db.Decimal(14, 2)
  neto                       Decimal          @db.Decimal(14, 2)
  iva_monto                  Decimal          @db.Decimal(14, 2)
  total                      Decimal          @db.Decimal(14, 2)
  estado                     EstadoCotizacion @default(BORRADOR)
  observaciones              String?
  condiciones                String?
  user_id                    String
  created_at                 DateTime         @default(now())
  updated_at                 DateTime         @updatedAt
  items                      QuotationItem[]

  @@index([company_id])
  @@index([estado])
  @@map("quotations")
}

model QuotationItem {
  id                    String    @id @default(cuid())
  quotation_id          String
  orden                 Int
  descripcion           String
  tipo                  String
  valor_hora            Decimal   @db.Decimal(12, 2)
  horas_minimas_diarias Int       @default(0)
  cantidad_horas        Decimal   @default(0) @db.Decimal(12, 2)
  cantidad_dias         Decimal   @default(0) @db.Decimal(12, 2)
  subtotal              Decimal   @db.Decimal(14, 2)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  quotation             Quotation @relation(fields: [quotation_id], references: [id], onDelete: Cascade)

  @@index([quotation_id])
  @@map("quotation_items")
}

// ============================================================
// MÓDULOS MANTENCIÓN / OPERACIÓN  (aislados, offline, uuid client-generated)
// Tablas mant_* — operadores = Profile del portal. Bookkeeping de sync
// (synced/sync_queue) vive solo en PGlite local, no aquí.
// ============================================================

model MantEquipo {
  id               String            @id @default(uuid())
  codigo           String            @unique
  nombre           String
  tipo             String
  marca            String?
  modelo           String?
  numero_serie     String?
  patente          String?
  anio             Int?
  horometro_actual Decimal           @default(0) @db.Decimal(10, 2)
  km_actual        Decimal           @default(0) @db.Decimal(10, 2)
  estado           String            @default("Activo")
  imagen_url       String?
  soap_vencimiento         DateTime?  @db.Date
  permiso_circ_vencimiento DateTime?  @db.Date
  rev_tecnica_vencimiento  DateTime?  @db.Date
  extintor_vencimiento     DateTime?  @db.Date
  deleted_at       DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  partes_diarios   MantParteDiario[]
  mantenciones     MantMantencion[]
  checklists       MantChecklist[]
  certificados     MantCertificado[]
  checklists_mantencion   MantChecklistMantencion[]
  certificados_mantencion MantCertificadoMantencion[]

  @@index([estado])
  @@index([updated_at])
  @@map("mant_equipos")
}

model MantParteDiario {
  id                  String     @id @default(uuid())
  equipo_id           String
  operador_id         String
  fecha               DateTime   @db.Date
  horometro_inicio    Decimal?   @db.Decimal(10, 2)
  horometro_fin       Decimal?   @db.Decimal(10, 2)
  km_inicio           Decimal?   @db.Decimal(10, 2)
  km_fin              Decimal?   @db.Decimal(10, 2)
  combustible_litros  Decimal?   @db.Decimal(8, 2)
  aceite_litros       Decimal?   @db.Decimal(8, 2)
  descripcion_trabajo String?
  observaciones       String?
  estado              String     @default("Pendiente")
  firma_operador_b64  String?
  firma_encargado_b64 String?
  foto_urls           String[]   @default([])
  area_uso             String?
  centro_costo         String?
  tipo_mantencion      String?
  combustible_fraccion String?
  nombre_responsable   String?
  rut_responsable      String?
  nombre_receptor      String?
  rut_receptor         String?
  horometro            Decimal?   @db.Decimal(10, 2)
  odometro             Decimal?   @db.Decimal(10, 2)
  componentes          Json?
  fotos_tablero        String[]   @default([])
  fotos_entrada        String[]   @default([])
  fotos_salida         String[]   @default([])
  fecha_salida         DateTime?  @db.Date
  firma_receptor_b64   String?
  deleted_at          DateTime?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt
  equipo              MantEquipo @relation(fields: [equipo_id], references: [id])
  operador            Profile    @relation("ParteDiarioOperador", fields: [operador_id], references: [id])

  @@index([equipo_id])
  @@index([operador_id])
  @@index([fecha])
  @@index([updated_at])
  @@map("mant_partes_diarios")
}

model MantMantencion {
  id                           String     @id @default(uuid())
  equipo_id                    String
  responsable_id               String
  tipo                         String
  fecha_inicio                 DateTime
  fecha_fin                    DateTime?
  horometro_realizada          Decimal?   @db.Decimal(10, 2)
  descripcion                  String
  trabajos_realizados          String?
  repuestos_usados             String?
  costo                        Decimal?   @db.Decimal(12, 2)
  proxima_mantencion_horometro Decimal?   @db.Decimal(10, 2)
  proxima_mantencion_fecha     DateTime?  @db.Date
  estado                       String     @default("En Proceso")
  observaciones                String?
  deleted_at                   DateTime?
  created_at                   DateTime   @default(now())
  updated_at                   DateTime   @updatedAt
  equipo                       MantEquipo @relation(fields: [equipo_id], references: [id])
  responsable                  Profile    @relation("MantencionResponsable", fields: [responsable_id], references: [id])

  @@index([equipo_id])
  @@index([estado])
  @@index([updated_at])
  @@map("mant_mantenciones")
}

model MantChecklist {
  id                    String     @id @default(uuid())
  equipo_id             String
  operador_id           String
  fecha                 DateTime   @default(now())
  nivel_aceite          Boolean?
  nivel_combustible     Boolean?
  nivel_agua_radiador   Boolean?
  nivel_hidraulico      Boolean?
  presion_neumaticos    Boolean?
  luces_funcionan       Boolean?
  frenos_funcionan      Boolean?
  cinturon_seguridad    Boolean?
  extintor_presente     Boolean?
  documentacion_vigente Boolean?
  limpieza_cabina       Boolean?
  alarma_retroceso      Boolean?
  estado_cucharas       Boolean?
  fugas_aceite          Boolean?
  fugas_combustible     Boolean?
  estado_general        String     @default("Apto")
  observaciones         String?
  firma_operador_b64    String?
  anulado_at            DateTime?
  motivo_anulacion      String?
  anulado_por_id        String?
  created_at            DateTime   @default(now())
  updated_at            DateTime   @updatedAt
  equipo                MantEquipo @relation(fields: [equipo_id], references: [id])
  operador              Profile    @relation("ChecklistOperador", fields: [operador_id], references: [id])
  anulado_por           Profile?   @relation("ChecklistAnuladoPor", fields: [anulado_por_id], references: [id])

  @@index([equipo_id])
  @@index([operador_id])
  @@index([fecha])
  @@index([updated_at])
  @@map("mant_checklists")
}

model MantCertificado {
  id                  String     @id @default(uuid())
  equipo_id           String
  tipo                String
  numero              String?
  fecha_emision       DateTime?  @db.Date
  fecha_vencimiento   DateTime   @db.Date
  empresa_emisora     String?
  observaciones       String?
  documento_url       String?
  firma_encargado_b64 String?
  deleted_at          DateTime?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt
  equipo              MantEquipo @relation(fields: [equipo_id], references: [id])

  @@index([equipo_id])
  @@index([fecha_vencimiento])
  @@index([updated_at])
  @@map("mant_certificados")
}

model MantChecklistMantencion {
  id                      String     @id @default(uuid())
  correlativo             Int
  equipo_id               String
  responsable_id          String?
  fecha                   DateTime   @default(now()) @db.Date
  tipo_mantencion         String
  empresa                 String     @default("SOLTERRA")
  patente_snapshot        String?
  km_snapshot             Decimal?   @db.Decimal(10, 2)
  horometro_snapshot      Decimal?   @db.Decimal(10, 2)
  proxima_mantencion      Decimal?   @db.Decimal(10, 2)
  items                   Json?
  observaciones_generales String?
  firma_encargado_b64     String?
  anulado_at              DateTime?
  motivo_anulacion        String?
  anulado_por_id          String?
  created_at              DateTime   @default(now())
  updated_at              DateTime   @updatedAt
  equipo                  MantEquipo @relation(fields: [equipo_id], references: [id])
  responsable             Profile?   @relation("ChecklistMantResponsable", fields: [responsable_id], references: [id])
  anulado_por             Profile?   @relation("ChecklistMantAnuladoPor", fields: [anulado_por_id], references: [id])

  @@index([equipo_id])
  @@index([fecha])
  @@map("mant_checklists_mantencion")
}

model MantCertificadoMantencion {
  id                   String     @id @default(uuid())
  correlativo          Int
  equipo_id            String
  responsable_id       String?
  gerente_id           String?
  fecha                DateTime   @default(now()) @db.Date
  ciudad               String     @default("Calama")
  tipo_equipo_snapshot String?
  marca_snapshot       String?
  patente_snapshot     String?
  horometro_snapshot   Decimal?   @db.Decimal(10, 2)
  odometro_snapshot    Decimal?   @db.Decimal(10, 2)
  proxima_mantencion   Decimal?   @db.Decimal(10, 2)
  firma_encargado_b64  String?
  firma_gerente_b64    String?
  anulado_at           DateTime?
  motivo_anulacion     String?
  anulado_por_id       String?
  created_at           DateTime   @default(now())
  updated_at           DateTime   @updatedAt
  equipo               MantEquipo @relation(fields: [equipo_id], references: [id])
  responsable          Profile?   @relation("CertMantEncargado", fields: [responsable_id], references: [id])
  gerente              Profile?   @relation("CertMantGerente", fields: [gerente_id], references: [id])
  anulado_por          Profile?   @relation("CertMantAnuladoPor", fields: [anulado_por_id], references: [id])

  @@index([equipo_id])
  @@index([fecha])
  @@map("mant_certificados_mantencion")
}
